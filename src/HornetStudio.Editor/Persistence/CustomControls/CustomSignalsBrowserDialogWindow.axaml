<Window
    x:Class="HornetStudio.Editor.Persistence.CustomControls.CustomSignalsBrowserDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HornetStudio.Editor.Persistence.CustomControls"
    Width="980"
    Height="720"
    MinWidth="820"
    MinHeight="560"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Custom Signals Browser"
    Background="{Binding DialogBackground}">
  <Grid Margin="16" RowDefinitions="Auto,*">
    <TextBlock FontSize="13"
               Foreground="{Binding SecondaryTextBrush}"
               Text="Browse and manage folder-local custom signal YAML files without placing a legacy CustomSignals widget on the canvas."
               TextWrapping="Wrap" />

    <Border Grid.Row="1"
            Margin="0,12,0,0"
            Padding="12"
            Background="{Binding PanelBackground}"
            BorderBrush="{Binding BorderColor}"
            BorderThickness="1"
            CornerRadius="12">
      <controls:CustomSignalsBrowserControl x:Name="CustomSignalsBrowserControl" />
    </Border>
  </Grid>
</Window>
